{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasky",
  "version": "0.1.0",
  "identifier": "com.tasky.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tasky",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0A0A0B",
        "label": "main",
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://yfcidccclkndbqhqpmzp.supabase.co wss://yfcidccclkndbqhqpmzp.supabase.co",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tasky",
    "shortDescription": "Gestor personal de proyectos, tareas e ideas",
    "copyright": "© 2026",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
